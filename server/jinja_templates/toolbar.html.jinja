<header class="toolbar">
<div class="home">
    <a href="../">
        <span class="logo">🇪🇺</span>
        <span class="brand">Qui vote quoi&nbsp;?<small>Les votes des eurodéputés français</small></span>
    </a>
</div>
<div class="search_group">
    <label class="search_field" for="search-input">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input id="search-input" type="search" placeholder="Ukraine, Israël, agriculture, covid, ..." class="input_search"/>
    </label>
    <div class="date-range">
        <label for="min-date">Du</label>
        <input type="date" id="min-date" class="date-input" name="min-date" value="2014-07-01">
        <label for="max-date">au</label>
        <input type="date" id="max-date" class="date-input" name="max-date">
    </div>
    <button id="search-btn" class="primary" onclick="search()">Rechercher</button>
    <div id="mep-suggestions" class="mep_suggestions" role="listbox" hidden></div>
</div>
<nav class="about"><a href="/classement">Classement</a><a href="../about">À propos</a></nav>
</header>

