{% from "podiums.html.jinja" import podium_cards %}
{% from "filters.html.jinja" import filters_query, filter_bar, votes_description %}
<!doctype html>
<html lang="fr">
<head>
    {% include "favicon.html.jinja" %}
    <style>{{ css }}</style>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Classement des députés - Qui vote quoi ?</title>
    <meta name="description" content="Classement des députés français au parlement européen : absentéisme et corrections de vote">
</head>
<body>
{% include "toolbar.html.jinja" %}
<div id="content">

<h1>Classement des {{ "groupes politiques" if by_group else "députés" }}</h1>
{% set extra = {"vue": "groupes"} if by_group else {} %}
{# Filters kept in the links to the members and groups pages #}
{% set query = filters_query(filters) %}

<p class="ranking_intro">
    Sur {{ votes_description(filters) }} tenus pendant le mandat de chaque député.
    {% if by_group %}Chaque député compte dans son dernier groupe de la période. L'absentéisme porte sur l'ensemble
    des votes du groupe, les autres nombres sont des moyennes par député.{% endif %}
</p>

{{ filter_bar("/classement", filters, extra, by_group) }}

{% macro member_row(member, rank, group=None) %}
        <tr class="ranking_member" data-absent_rate="{{ member.absent_rate }}" data-absent="{{ member.absent }}"
            data-corrections="{{ member.corrections }}" data-voted="{{ member.voted }}" data-name="{{ member.full_name | e }}"
            data-group="{{ (group or member.group) | e }}">
            <td class="ranking_rank">{{ rank }}</td>
            <td class="ranking_name"><a href="/membre/{{ member.id }}{{ query }}">{{ member.full_name }}</a></td>
            <td class="ranking_group">{{ member.group | political_group }}</td>
            <td class="number">{{ "{:.0f}".format(100 * member.absent_rate) }}&nbsp;%</td>
            <td class="number">{{ member.absent | fr_number }}</td>
            <td class="number">{{ member.corrections | fr_number }}</td>
            <td class="number">{{ member.voted | fr_number }}</td>
        </tr>
{% endmacro %}

{% if members %}
{{ podium_cards(podiums, by_group, query) }}

<h2>Classement complet</h2>
<div class="ranking_scroll">
<table class="ranking_table{{ " grouped" if by_group }}" id="ranking">
    <thead>
        <tr>
            <th class="ranking_rank">n<sup>o</sup></th>
            <th>{{ "Groupe" if by_group else "Député" }}</th>
            <th class="ranking_group">Groupe</th>
            <th class="number"><button data-key="absent_rate" class="sorted">Absentéisme</button></th>
            <th class="number"><button data-key="absent">Votes manqués{{ "<span class=\"column_detail\"> (moyenne)</span>" if by_group }}</button></th>
            <th class="number"><button data-key="corrections">Trompé de bouton{{ "<span class=\"column_detail\"> (moyenne)</span>" if by_group }}</button></th>
            <th class="number"><button data-key="voted">Votes{{ "<span class=\"column_detail\"> (moyenne)</span>" if by_group }}</button></th>
        </tr>
    </thead>
    <tbody>
    {% if by_group %}
        {# The members are listed under their group, they can be folded (see the script) #}
        {% for group in groups | sort(attribute="group") | sort(attribute="absent_rate", reverse=true) %}
        <tr class="ranking_group_row" data-absent_rate="{{ group.absent_rate }}" data-absent="{{ group.absent_average }}"
            data-corrections="{{ group.corrections_average }}" data-voted="{{ group.voted_average }}"
            data-name="{{ group.group | e }}" data-group="{{ group.group | e }}">
            <td class="ranking_rank">{{ loop.index }}</td>
            <td>
                <button type="button" class="ranking_expand" aria-expanded="true">
                    <span class="ranking_chevron" aria-hidden="true"></span>
                    {% set logo = group.group | political_group_logo %}
                    <span class="group_logo">{% if logo %}<img src="{{ logo.url }}" alt=""{{ ' style="filter: brightness(%s)"' % logo.brightness if logo.brightness != 1 }}{{ ' class="logo_rounded"' if logo.rounded }}>{% endif %}</span>
                    {{ group.group | political_group }}
                    <span class="ranking_group_count">{{ group.members_count }} député{{ "s" if group.members_count > 1 }}</span>
                </button>
                <a class="ranking_group_link" href="/groupe/{{ group.group | group_slug }}{{ query }}" aria-label="Page du groupe {{ group.group | political_group }}">→</a>
            </td>
            <td class="ranking_group"></td>
            <td class="number">{{ "{:.0f}".format(100 * group.absent_rate) }}&nbsp;%</td>
            <td class="number">{{ group.absent_average | round | int | fr_number }}</td>
            <td class="number">{{ group.corrections_average | fr_decimal }}</td>
            <td class="number">{{ group.voted_average | round | int | fr_number }}</td>
        </tr>
            {% for member in group.members | sort(attribute="full_name") | sort(attribute="absent_rate", reverse=true) %}
                {{ member_row(member, loop.index, group.group) }}
            {% endfor %}
        {% endfor %}
    {% else %}
        {% for member in members | sort(attribute="full_name") | sort(attribute="absent_rate", reverse=true) %}
            {{ member_row(member, member.ranks.absent_rate) }}
        {% endfor %}
    {% endif %}
    </tbody>
</table>
</div>
{% else %}
<p>Aucun vote par appel nominal n'a eu lieu sur cette période.</p>
{% endif %}

</div>

<script>
(function () {
    const table = document.getElementById("ranking");
    if (!table) return;
    const body = table.tBodies[0];
    const groupRows = Array.from(body.querySelectorAll(".ranking_group_row"));
    const memberRows = Array.from(body.querySelectorAll(".ranking_member"));

    function ranked(rows, key) {
        // Decreasing values; equal values share the same rank (1, 1, 3, ...)
        rows.sort((a, b) => Number(b.dataset[key]) - Number(a.dataset[key]) || a.dataset.name.localeCompare(b.dataset.name, "fr"));
        let previous = null, rank = 0;
        rows.forEach((row, position) => {
            if (row.dataset[key] !== previous) rank = position + 1;
            previous = row.dataset[key];
            row.cells[0].textContent = rank;
        });
        return rows;
    }

    function membersOf(groupRow) {
        return memberRows.filter((row) => row.dataset.group === groupRow.dataset.group);
    }

    function sort(key) {
        if (groupRows.length) {
            // Each group, then its members ranked within the group
            ranked(groupRows, key).forEach((groupRow) => {
                body.appendChild(groupRow);
                ranked(membersOf(groupRow), key).forEach((row) => body.appendChild(row));
            });
        } else {
            ranked(memberRows, key).forEach((row) => body.appendChild(row));
        }
        table.querySelectorAll("th button").forEach((button) => button.classList.toggle("sorted", button.dataset.key === key));
    }

    function fold(groupRow, expanded) {
        groupRow.querySelector(".ranking_expand").setAttribute("aria-expanded", expanded);
        membersOf(groupRow).forEach((row) => row.hidden = !expanded);
    }

    // The groups are folded, so that their ranking is visible at a glance
    groupRows.forEach((groupRow) => {
        const button = groupRow.querySelector(".ranking_expand");
        button.addEventListener("click", () => fold(groupRow, button.getAttribute("aria-expanded") !== "true"));
        fold(groupRow, false);
    });
    table.querySelectorAll("th button").forEach((button) => button.addEventListener("click", () => sort(button.dataset.key)));
    sort("absent_rate");
})();
</script>
</body>
</html>
