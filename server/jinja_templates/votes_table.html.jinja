{% from "member.html.jinja" import mep_link %}

{% macro create_votes_table(votes, date, absent=None) %}

{% if votes | length > 0 %}

    {# The members who did not vote are listed after the abstentions #}
    {% set rows = votes.items() | list + ([("absent", absent)] if absent else []) %}
    <table class="votes_table">
    {% for vote_result, groups in rows %}
        {% set vote_class = vote_result | class_from_vote_result %}
        {% for group, members in groups.items() %}
        <tr class="{{ vote_class }}">
            <td class="political_group {{ group | political_group_class }} {{ vote_class }}"><a href="/groupe/{{ group | group_slug }}" class="tooltip"><span class="political_group_name {{ vote_class }}">{{ group | political_group }}</span><span class="tooltip_text">{{ group | political_group_tooltip(date) }}</span></a></td>
            <td class="{{ vote_class }}">
            {%- for is_last, member in members | is_last_iterator -%}
                {{ mep_link(member) }}{{ ", " if not is_last }}
            {%- endfor -%}
            </td>
        </tr>
        {% endfor %}
    {% endfor %}
    </table>

    <div class="legend tooltip">
    <span class="legend_item {{ "+" | class_from_vote_result }}">Ont voté pour</span>
    <span class="legend_item {{ "-" | class_from_vote_result }}">Ont voté contre</span>
    {% set abstained = votes.get("0", {}).values() | sum(start=[]) %}
    <span class="legend_item {{ "0" | class_from_vote_result }}">{{ agree(abstained, "Se sont abstenus", "Se sont abstenues") }}</span>
    {% if absent is not none %}
        <span class="legend_item {{ "absent" | class_from_vote_result }}">{{ agree(absent.values() | sum(start=[]), "Absents", "Absentes") }}</span>
        <span class="tooltip_text">Députés en fonction le jour du vote qui n'ont pas voté&nbsp;: absents, ou présents sans voter.</span>
    {% else %}
        <span class="tooltip_text">Les membres du parlement qui ne sont pas mentionnés ici étaient absents lors du vote.</span>
    {% endif %}
    </div>

{% endif %}

{% endmacro %}
