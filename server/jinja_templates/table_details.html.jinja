{% macro outcome(flag, verdict_class, verdict, n_for, n_against, n_abstained, tooltip) %}
{% set total = n_for + n_against + n_abstained %}
{# Only the winning side is highlighted: "pour" if the text was adopted, "contre" if it was rejected #}
{% set winner = "voted_for" if verdict_class == "adopted" else "voted_against" if verdict_class == "rejected" else none %}
<div class="outcome">
    <div class="outcome_flag tooltip">
        {{ flag }}
        <span class="tooltip_text">{{ tooltip }}</span>
    </div>
    {% if total > 0 %}
        <div class="vote_bar" role="img" aria-label="{{ verdict }} : {{ n_for }} pour, {{ n_against }} contre, {{ n_abstained }} abstentions">
            {% for count, vote_class, word in [(n_for, "voted_for", "pour"), (n_against, "voted_against", "contre"), (n_abstained, "abstained", "abstention" ~ ("s" if n_abstained > 1 else ""))] if count %}
                {# The count is shown on hover, or on tap on touch screens (focus) #}
                <span class="vote_segment {{ vote_class }}{{ " winner" if vote_class == winner }}" style="flex-grow: {{ count }}" tabindex="0"
                      data-tip="{{ count | fr_number }} {{ word }} · {{ "{:.0f}".format(100 * count / total) }}&nbsp;%"></span>
            {% endfor %}
        </div>
    {% else %}
        <div class="outcome_unavailable">{{ verdict }}{{ " (décompte des voix indisponible)" if verdict_class != "unknown" }}</div>
    {% endif %}
</div>
{% endmacro %}

{% macro create_table_details(eu_document_code, date, votes_source_url, source_url, votes_for, votes_against, votes_abstained, global) %}

<div class="details">

<div class="details_meta">
    <span>📅 {{ date | to_pretty_date }}</span>
    <a href="{{ votes_source_url }}" target="_blank">Source des votes ↗</a>
    <a href="{{ source_url }}" target="_blank">Lire {{ eu_document_code }} ↗</a>
</div>

<div class="outcomes">
    {% set gv = global["global_votes"] if "global_votes" in global and global["global_votes"]["+"] != "Données indisponibles" else none %}
    {{ outcome("🇪🇺",
               "adopted" if global["was_adopted"] else "rejected",
               "Adopté" if global["was_adopted"] else "Rejeté",
               gv["+"] if gv else 0, gv["-"] if gv else 0, gv["0"] if gv else 0,
               "Résultat du vote au parlement européen.") }}

    {% if global["was_roll_call_voted"] == True %}
        {% if votes_for != 0 or votes_against != 0 or votes_abstained != 0 %}
            {{ outcome("🇫🇷",
                       "adopted" if votes_for > votes_against else "rejected",
                       "Aurait été adopté" if votes_for > votes_against else "Aurait été rejeté",
                       votes_for, votes_against, votes_abstained,
                       "Résultat théorique du vote si seuls les députés français avaient voté.") }}
        {% else %}
            {{ outcome("🇫🇷", "unknown", "Données indisponibles", 0, 0, 0,
                       "Les données relatives au vote par appel nominal des députés français ne sont pas disponibles.") }}
        {% endif %}
    {% endif %}
</div>

</div>

{% endmacro %}
