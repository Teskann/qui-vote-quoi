{% macro outcome(title, verdict_class, verdict, n_for, n_against, n_abstained, tooltip) %}
{% set total = n_for + n_against + n_abstained %}
<div class="outcome {{ verdict_class }}">
    <div class="outcome_title{{ ' tooltip' if tooltip else '' }}">
        {{ title }}
        {% if tooltip %}<span class="tooltip_text">{{ tooltip }}</span>{% endif %}
    </div>
    <div class="outcome_verdict">{{ verdict }}</div>
    {% if total > 0 %}
        <div class="vote_bar" aria-hidden="true">
            {% if n_for %}<span class="voted_for" style="width: {{ 100 * n_for / total }}%"></span>{% endif %}
            {% if n_against %}<span class="voted_against" style="width: {{ 100 * n_against / total }}%"></span>{% endif %}
            {% if n_abstained %}<span class="abstained" style="width: {{ 100 * n_abstained / total }}%"></span>{% endif %}
        </div>
        <div class="vote_counts">
            <span class="voted_for"><b>{{ n_for }}</b> pour</span>
            <span class="voted_against"><b>{{ n_against }}</b> contre</span>
            <span class="abstained"><b>{{ n_abstained }}</b> abstention{{ "s" if n_abstained > 1 else "" }}</span>
        </div>
    {% else %}
        <div class="vote_counts">Décompte des voix indisponible</div>
    {% endif %}
</div>
{% endmacro %}

{% macro create_table_details(eu_document_code, date, votes_source_url, source_url, votes_for, votes_against, votes_abstained, global) %}

<div class="details">

<div class="details_meta">
    <span>📅 {{ date | to_pretty_date }}</span>
    <a href="{{ votes_source_url }}" target="_blank">Source des votes ↗</a>
    <a href="{{ source_url }}" target="_blank">Lire {{ eu_document_code }} ↗</a>
</div>

<div class="outcomes">
    {% set gv = global["global_votes"] if "global_votes" in global and global["global_votes"]["+"] != "Données indisponibles" else none %}
    {{ outcome("🇪🇺 Parlement européen",
               "adopted" if global["was_adopted"] else "rejected",
               "Adopté" if global["was_adopted"] else "Rejeté",
               gv["+"] if gv else 0, gv["-"] if gv else 0, gv["0"] if gv else 0,
               "Résultat du vote au parlement européen.") }}

    {% if global["was_roll_call_voted"] == True %}
        {% if votes_for != 0 or votes_against != 0 or votes_abstained != 0 %}
            {{ outcome("🇫🇷 Si seuls les Français avaient voté",
                       "adopted" if votes_for > votes_against else "rejected",
                       "Aurait été adopté" if votes_for > votes_against else "Aurait été rejeté",
                       votes_for, votes_against, votes_abstained,
                       "Résultat théorique du vote si seuls les députés français avaient voté.") }}
        {% else %}
            {{ outcome("🇫🇷 Si seuls les Français avaient voté", "unknown", "Données indisponibles", 0, 0, 0,
                       "Les données relatives au vote par appel nominal des députés français ne sont pas disponibles.") }}
        {% endif %}
    {% endif %}
</div>

</div>

{% endmacro %}
