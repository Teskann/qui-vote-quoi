{% macro mep_link(member) -%}
{%- if member is mapping and member.id -%}
<a class="mep" href="/membre/{{ member.id }}" data-id="{{ member.id }}" data-full-name="{{ member.full_name | e }}">{{ member.name }}</a>
{%- else -%}
{#- Members without identifier, or database filled before the identifiers were stored -#}
{{ member.name if member is mapping else member }}
{%- endif -%}
{%- endmacro %}
